rules_version = '2';

// Haru: invite-only. The owners manage `allow/{email}`; an invited (or an owner's) Google account reads and
// writes its own planner under `users/{uid}`, may look at (never change) the others' Today, and shares journal
// pages to the common `archive`. Paste into Firebase console → Firestore → Rules, or
// `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return signedIn() && email() in ['publicclaude223@gmail.com', 'yeomsh09@gmail.com'];
    }
    // a chat message's reactions of one kind before and after a change differ by the writer's own uid alone
    function reactsOnlyAs(kind) {
      let before = resource.data.get('reactions', {}).get(kind, []).toSet();
      let after = request.resource.data.reactions.get(kind, []).toSet();
      return after.size() <= 100
        && after.difference(before).hasOnly([request.auth.uid])
        && before.difference(after).hasOnly([request.auth.uid]);
    }
    // the one account that writes the Updates notice pinned in the Archive
    function isAdmin() {
      return signedIn() && email() == 'publicclaude223@gmail.com';
    }
    function isInvited() {
      return signedIn() && (isOwner() || exists(/databases/$(database)/documents/allow/$(email())));
    }

    // invitations: the owners list and edit them; anyone signed in may check their own entry
    match /allow/{invitee} {
      allow read: if isOwner() || (signedIn() && email() == invitee);
      allow write: if isOwner();
    }

    // who is in Haru (name, photo), for the Today switcher and the Archive; each writes only their own
    match /profiles/{uid} {
      allow read: if isInvited();
      allow write: if isInvited() && request.auth.uid == uid;
    }

    // each person's planner is their own…
    match /users/{uid}/{document=**} {
      allow read, write: if isInvited() && request.auth.uid == uid;
    }
    // …but everyone invited may look at (never change) anyone's Today, attendance and past days
    match /users/{uid}/state/timetable {
      allow read: if isInvited();
    }
    match /users/{uid}/lists/checkins {
      allow read: if isInvited();
    }
    match /users/{uid}/days/{date} {
      allow read: if isInvited();
    }

    // members taken off for not adding a task to Today for 5 days (the owners' Haru writes these): owners only
    match /expired/{email} {
      allow read, write: if isOwner();
    }

    // app settings the owners keep out of the public site (the NEIS API key): invited accounts read, owners write
    match /config/{doc} {
      allow read: if isInvited();
      allow write: if isOwner();
    }

    // change requests ("/변경요청 …" in the chat): queued by anyone invited, as themselves, under the chat message's id. Open to read
    // so the developer can list the queue without signing in (only the request's words are in it); nothing writes
    // back here (outcomes are published with the site)
    match /change-requests/{id} {
      allow read: if true;
      allow create: if isInvited() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000;
      allow delete: if isAdmin();
    }

    // the Updates notice pinned on top of the Archive: everyone invited reads it, only the admin writes it
    match /notices/{doc} {
      allow read: if isInvited();
      allow write: if isAdmin() && request.resource.data.body is string && request.resource.data.body.size() <= 20000;
      allow delete: if isAdmin();
    }

    // the shared archive: journal pages sent with Share. Everyone invited reads it; a page is written and
    // taken down only by its author (no one else, owners included)
    match /archive/{id} {
      allow read: if isInvited();
      allow create: if isInvited() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isInvited() && request.resource.data.authorUid == request.auth.uid && resource.data.authorUid == request.auth.uid;
      allow delete: if isInvited() && resource.data.authorUid == request.auth.uid;
    }
    // the chat room: everyone invited reads it and writes as themselves (up to 1000 characters, 4 photos); a message is
    // taken back by whoever sent it (or an owner)
    match /chat/{id} {
      allow read: if isInvited();
      // text (Markdown) and/or up to four photos carried in the message
      allow create: if isInvited() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && (request.resource.data.text.size() > 0
          || (request.resource.data.images is list && request.resource.data.images.size() > 0))
        && (!('images' in request.resource.data) || (request.resource.data.images is list && request.resource.data.images.size() <= 4))
        // marked as a change request: a plain flag
        && (!('request' in request.resource.data) || request.resource.data.request == true);
      // a heart or a check: anyone invited changes only the reactions, and only their own uid in them
      allow update: if isInvited()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && request.resource.data.reactions is map
        && request.resource.data.reactions.keys().hasOnly(['heart', 'check'])
        && reactsOnlyAs('heart') && reactsOnlyAs('check');
      allow delete: if isInvited() && (resource.data.uid == request.auth.uid || isOwner());
    }
    // the shared board: everyone invited sees it and draws as themselves (a stroke of up to 1500 points); a stroke
    // is taken back by whoever drew it, or an owner clears the board
    match /board/{id} {
      allow read: if isInvited();
      allow create: if isInvited() && request.resource.data.uid == request.auth.uid
        && request.resource.data.pts is list && request.resource.data.pts.size() <= 3000;
      allow delete: if isInvited() && (resource.data.uid == request.auth.uid || isOwner());
    }
    // comments under a shared page: everyone invited reads and writes their own (as themselves, up to 1000
    // characters); a comment is taken down by whoever wrote it or by the page's author
    match /archive/{id}/comments/{cid} {
      allow read: if isInvited();
      allow create: if isInvited() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
      allow delete: if isInvited() && (resource.data.uid == request.auth.uid
        || get(/databases/$(database)/documents/archive/$(id)).data.authorUid == request.auth.uid);
    }
  }
}
