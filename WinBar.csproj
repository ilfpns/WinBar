<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Bluetooth 켜기·끄기(Windows.Devices.Radios)를 위해 공식 Windows SDK 연결을 사용한다(사용자 허락). 최소 지원은 Windows 10 1809. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>WinBar</AssemblyName>
    <RootNamespace>WinBar</RootNamespace>
    <!-- 메모리 40MB 기준: ICU 로드 제거, 백그라운드 GC 스레드와 PGO 계측 비활성화 -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <!-- GPU 카운터 버퍼를 문자열로 바꾸지 않고 직접 읽기 위해 사용 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- 배포 정보: Windows 10/11 전용 프로토타입 (exe 파일 속성과 설정 > 정보에 표시) -->
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0-prototype</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>WinBar (Prototype)</Product>
    <AssemblyTitle>WinBar - macOS style menu bar for Windows 10/11 (prototype)</AssemblyTitle>
    <Description>Prototype. Windows 10/11 (x64) only.</Description>
  </PropertyGroup>
</Project>
